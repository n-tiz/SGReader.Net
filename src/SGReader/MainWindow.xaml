<ui:FluentWindow x:Class="SGReader.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:local="clr-namespace:SGReader"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 x:Name="Root"
                 Title="SGReader"
                 Width="1280"
                 Height="800"
                 MinWidth="960"
                 MinHeight="640"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 d:DataContext="{d:DesignInstance local:MainWindowViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="SGReader"
                     Height="32"
                     Background="{StaticResource AppSidebarBrush}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Icon.png"
                              Width="16"
                              Height="16"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <Button ToolTip="Source on GitHub"
                        Width="36"
                        Height="28"
                        Margin="0,0,4,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Command="{Binding GoToGithubCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="15" Height="15">
                        <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                              Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                    </Viewbox>
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" MinWidth="200" MaxWidth="480" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Library -->
            <Border Grid.Column="0"
                    Background="{StaticResource AppSidebarBrush}">
                <DockPanel Margin="14,10,14,14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <ui:Button DockPanel.Dock="Right"
                                   Appearance="Transparent"
                                   ToolTip="Open SG2/SG3"
                                   Icon="{ui:SymbolIcon Symbol=Add24}"
                                   Command="{Binding OpenCommand}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LIBRARY"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Opacity="0.5" />
                            <TextBlock Text="Opened files"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <ui:TextBox DockPanel.Dock="Top"
                                Margin="0,0,0,12"
                                PlaceholderText="Filter files or animations…"
                                ClearButtonEnabled="True"
                                Text="{Binding FileSearch, UpdateSourceTrigger=PropertyChanged}"
                                Icon="{ui:SymbolIcon Symbol=Search24}" />

                    <TextBlock DockPanel.Dock="Bottom"
                               Margin="4,12,4,0"
                               FontSize="12"
                               Foreground="{StaticResource AppSubtleTextBrush}"
                               Text="SG2 / SG3 · Impressions Games"
                               Opacity="0.8" />

                    <Grid>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="8">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFiles}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="FolderOpen24"
                                           FontSize="28"
                                           Opacity="0.35"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10" />
                            <TextBlock Text="No files yet"
                                       Opacity="0.55"
                                       HorizontalAlignment="Center" />
                            <ui:Button Appearance="Transparent"
                                       Content="Browse…"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Command="{Binding OpenCommand}" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding FilteredFiles}"
                                 SelectedItem="{Binding SelectedSGFile}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource FileListItem}">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFiles}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SGFileViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                Background="{StaticResource CheckerBrush}"
                                                ClipToBounds="True"
                                                Margin="0,0,10,0">
                                            <Grid>
                                                <ui:SymbolIcon Symbol="Document24"
                                                               Opacity="0.45"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       StretchDirection="DownOnly"
                                                       Margin="3"
                                                       SnapsToDevicePixels="True"
                                                       UseLayoutRounding="True"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AppSubtleTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TypesLabel}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AppSubtleTextBrush}"
                                                       Opacity="0.85"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding TypesLabel}" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="2"
                                                   Appearance="Transparent"
                                                   ToolTip="Close"
                                                   VerticalAlignment="Center"
                                                   Focusable="False"
                                                   Command="{Binding DataContext.CloseFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Background="{StaticResource AppDividerBrush}"
                          Cursor="SizeWE" />

            <!-- Workspace -->
            <Grid Grid.Column="2" Background="{StaticResource AppPaneBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding SelectedSGFile, Converter={StaticResource InverseNullToVisibilityConverter}}">
                    <Image Source="pack://application:,,,/Icon.png"
                           Width="96"
                           Height="96"
                           Margin="0,0,0,18"
                           HorizontalAlignment="Center"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Browse city-building sprites"
                               FontSize="26"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Open an SG2 or SG3 archive to explore animations, orientations and frames."
                               Margin="0,8,0,22"
                               Foreground="{StaticResource AppSubtleTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="420"
                               TextWrapping="Wrap" />
                    <ui:Button Appearance="Primary"
                               Content="Open SG file"
                               Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                               HorizontalAlignment="Center"
                               Command="{Binding OpenCommand}" />
                </StackPanel>

                <local:SGFileView DataContext="{Binding SelectedSGFile}"
                                  Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="2"
              Panel.ZIndex="100"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#99000000" />
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="280"
                    Padding="28,24"
                    CornerRadius="14"
                    Background="{StaticResource AppCardBrush}"
                    BorderBrush="{StaticResource AppDividerBrush}"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="48"
                                     Height="48"
                                     HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LoadingMessage}"
                               Margin="0,16,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="260" />
                    <TextBlock Text="Decoding sprites…"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource AppSubtleTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
