<Application x:Class="SGReader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:SGReader.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <helpers:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <SolidColorBrush x:Key="AppSidebarBrush" Color="#CC202020" />
            <SolidColorBrush x:Key="AppPaneBrush" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="AppInspectorBrush" Color="#FF202020" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="AppCardHoverBrush" Color="#FF343434" />
            <SolidColorBrush x:Key="AppCardSelectedBrush" Color="#FF3A3A3A" />
            <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#FFADADAD" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="CheckerLightBrush" Color="#FF3C3C3C" />
            <SolidColorBrush x:Key="CheckerDarkBrush" Color="#FF2C2C2C" />

            <DrawingBrush x:Key="CheckerBrush"
                          TileMode="Tile"
                          Viewport="0,0,12,12"
                          ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource CheckerDarkBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,12,12" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource CheckerLightBrush}">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,6,6" />
                                    <RectangleGeometry Rect="6,6,6,6" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <Style x:Key="FileListItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Root"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,9"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AppCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AppCardSelectedBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppDividerBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SpriteCardItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card"
                                    Background="{StaticResource AppCardBrush}"
                                    BorderBrush="{StaticResource AppDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource AppCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource AppCardSelectedBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#55FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MetaChip" TargetType="Border">
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
