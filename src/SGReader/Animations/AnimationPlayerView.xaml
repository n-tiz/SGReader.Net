<UserControl x:Class="SGReader.Animations.AnimationPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:animations="clr-namespace:SGReader.Animations"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="260"
             d:DataContext="{d:DesignInstance animations:AnimationPlayerViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="270" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CheckerBrush}"
                BorderBrush="{StaticResource AppDividerBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Grid>
                <TextBlock Text="{Binding StatusLabel}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AppSubtleTextBrush}"
                           Visibility="{Binding CurrentBitmap, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                <Canvas Width="{Binding LayoutWidth}"
                        Height="{Binding LayoutHeight}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding CurrentBitmap, Converter={StaticResource NullToVisibilityConverter}}">
                    <Image Source="{Binding CurrentBitmap}"
                           Canvas.Left="{Binding DrawX}"
                           Canvas.Top="{Binding DrawY}"
                           Stretch="None"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <UniformGrid Columns="2">
                <ui:Button Appearance="Primary"
                           Height="38"
                           Margin="0,0,6,0"
                           Content="Play / Pause"
                           Icon="{ui:SymbolIcon Symbol=Play24}"
                           Command="{Binding TogglePlayCommand}" />
                <ui:Button Appearance="Secondary"
                           Height="38"
                           Margin="6,0,0,0"
                           Content="Save"
                           Icon="{ui:SymbolIcon Symbol=Save24}"
                           ToolTip="Save current frame as PNG"
                           Command="{Binding SaveFrameCommand}" />
            </UniformGrid>
        </StackPanel>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="14,12"
                CornerRadius="12"
                Background="{StaticResource AppCardBrush}"
                BorderBrush="{StaticResource AppDividerBrush}"
                BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Frame duration"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Background="#18FFFFFF"
                            CornerRadius="6"
                            Padding="8,3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Frame, StringFormat={}{0:0.00} s}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource AppSubtleTextBrush}" />
                    </Border>
                </Grid>
                <Slider Value="{Binding Frame}"
                        Minimum="{Binding MinimumFrame}"
                        Maximum="{Binding MaximumFrame}"
                        TickFrequency="{Binding TickFrequency}"
                        IsSnapToTickEnabled="True" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="11"
                           LineHeight="16"
                           Foreground="{StaticResource AppSubtleTextBrush}"
                           Text="Lower values play faster." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
